# Website (safe to be public). From Supabase > Project Settings > API Keys.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set to "off" to hide the "Continue with Google" button.
VITE_GOOGLE_SIGNIN=on

# Server only (keep secret). Set these in Netlify, never in the code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
