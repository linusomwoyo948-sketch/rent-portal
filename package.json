{
  "name": "rent-portal",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "local": "concurrently -k -n server,site -c blue,green \"npm:local:server\" \"npm:local:site\"",
    "local:server": "tsx watch local/server.ts",
